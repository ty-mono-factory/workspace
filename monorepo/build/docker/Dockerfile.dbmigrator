ARG base_image=node:22.15.0-slim
FROM ${base_image}

ARG app_gid=1000
ARG app_uid=1000

WORKDIR /workspace

RUN --mount=type=bind,source=offline,target=/workspace/offline <<'EOF'
set -e
APT_OPTS="-o Dir::Etc::sourcelist=/dev/null -o Dir::Etc::sourceparts=/dev/null"
cd /workspace/offline
sha256sum -c checksum.sha256
apt-get update ${APT_OPTS}
apt-get install -y --no-install-recommends ${APT_OPTS} /workspace/offline/*.deb
mkdir -p /opt/prisma-cli
tar -xzf /workspace/offline/prisma-cli-7.9.1.tgz -C /opt/prisma-cli
ln -sf /opt/prisma-cli/node_modules/.bin/prisma /usr/local/bin/prisma
test -x /usr/local/bin/prisma || { echo "prisma symlink broken" >&2; exit 1; }
prisma --version
getent group "${app_gid}" >/dev/null || groupadd -r app -g "${app_gid}"
getent passwd "${app_uid}" >/dev/null || useradd -r -g app -u "${app_uid}" -d /workspace app
EOF

ENV NODE_ENV=production \
    PRISMA_CLI_QUERY_ENGINE_TYPE=binary \
    PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x

WORKDIR /migration
ENTRYPOINT ["prisma"]
CMD ["migrate", "deploy", "--config", "/migration/prisma.config.js"]
