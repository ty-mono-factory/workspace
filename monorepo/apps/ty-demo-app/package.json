{
    "name": "@monorepo/ty-demo-app",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "dev": "nuxt dev --dotenv ../../.env",
        "build": "nuxt build --dotenv ../../.env",
        "clean": "rm -rf .nuxt .output .turbo node_modules/.cache",
        "generate": "nuxt generate --dotenv ../../.env",
        "preview": "nuxt preview --dotenv ../../.env",
        "start": "node .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "lint": "eslint . --fix",
        "typecheck": "nuxt typecheck --dotenv ../../.env",
        "test:contracts": "tsx --test ./tests/*.test.ts"
    },
    "dependencies": {
        "@monorepo/access-server": "workspace:*",
        "@monorepo/ty-demo": "workspace:*",
        "@monorepo/logger": "workspace:*",
        "vue": "catalog:",
        "vue-router": "catalog:"
    },
    "devDependencies": {
        "@monorepo/config": "workspace:*",
        "@monorepo/types": "workspace:*",
        "@monorepo/tooling": "workspace:*",
        "nuxt": "catalog:",
        "@nuxt/ui": "catalog:",
        "magicast": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vue-tsc": "catalog:"
    }
}