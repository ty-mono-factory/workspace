# Docker --env-file format: KEY=value, no export, quotes or shell expansion.
# Supply the same file to the application and database migrator.
# DATABASE_URL must address the same persistent database in both containers.
DATABASE_URL=file:/data/access-web.db
# DATABASE_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:10001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TRUSTED_ORIGINS=http://localhost:10001,http://localhost:10002
ACCESS_BOOTSTRAP_ADMIN_ENABLED=false
# Nuxt runtime overrides: use these for already-built delivery artifacts.
NUXT_PUBLIC_TY_DEMO_URL=http://localhost:10002/
NUXT_PUBLIC_ACCESS_WEB_URL=http://localhost:10001
NUXT_ACCESS_MODE=authenticated
PORT=10001
HOST=0.0.0.0
