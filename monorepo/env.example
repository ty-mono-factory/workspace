# 应用地址与端口
ACCESS_WEB_PORT=10001
DEMO_PORT=10002
ACCESS_WEB_URL=http://localhost:10001
TY_DEMO_URL=http://localhost:10002/

# public 允许匿名访问；authenticated 要求有效 Access Session
TY_DEMO_ACCESS_MODE=authenticated

# 数据库
DATABASE_URL=file:///workspace/data/monorepo/database/dev.db
# 仅远程 libSQL/Turso 需要
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:10001
# 逗号分隔；BETTER_AUTH_URL 会被自动加入
ACCESS_TRUSTED_ORIGINS=http://localhost:10001,http://localhost:10002,http://192.168.31.201:10001,http://192.168.31.201:10002
ACCESS_SESSION_TTL_MINS=1440
ACCESS_PASSWORD_MIN_LENGTH=10
ACCESS_PASSWORD_MAX_LENGTH=128

# 开发期首个管理员引导（默认关闭）
ACCESS_BOOTSTRAP_ADMIN_ENABLED=false
ACCESS_BOOTSTRAP_ADMIN_USERNAME=admini
ACCESS_BOOTSTRAP_ADMIN_PASSWORD=123456@Abcde
ACCESS_BOOTSTRAP_ADMIN_EMAIL=admini@devops.com
ACCESS_BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Node 环境
NODE_ENV=development
