{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "tsconfig.json",
        "**/prisma/schema.prisma",
        "**/prisma.config.ts"
    ],
    "globalEnv": [
        "DATABASE_*",
        "TURSO_AUTH_TOKEN",
        "BETTER_AUTH_*",
        "ACCESS_*",
        "TY_DEMO_*",
        "DEMO_PORT",
        "NUXT_*",
        "NITRO_*",
        "NODE_ENV",
        "PORT",
        "HOST"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "src/**/*",
                "*.ts",
                "package.json",
                "tsconfig.json",
                "prisma/schema.prisma"
            ],
            "outputs": [
                "dist/**",
                "build/**",
                ".nuxt/**",
                ".output/**",
                "src/generated/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [],
            "inputs": [
                "**/*.ts",
                "**/*.js",
                "**/*.vue",
                "eslint.config.js",
                "tsconfig.json"
            ],
            "outputs": []
        },
        "db:generate": {
            "inputs": [
                "./prisma/schema.prisma"
            ],
            "outputs": [
                "src/generated/**"
            ],
            "cache": true
        },
        "db:push": {
            "cache": false
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        }
    }
}