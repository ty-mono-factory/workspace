{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "tsconfig.json",
        "scripts/run-turbo.mjs"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**",
                "!**/*.tsbuildinfo",
                "!tests/**",
                "!delivery/**",
                "!README*"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@monorepo/database#build": {
            "dependsOn": [
                "^build",
                "db:generate"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**",
                "!**/*.tsbuildinfo",
                "!tests/**",
                "!delivery/**",
                "!README*"
            ],
            "outputs": []
        },
        "@monorepo/database#db:generate": {
            "inputs": [
                "prisma/schema.prisma",
                "prisma.config.ts",
                "package.json"
            ],
            "env": [
                "TURBO_ROOT_ENV",
                "DATABASE_URL",
                "NODE_ENV"
            ],
            "outputs": [
                "src/generated/**"
            ]
        },
        "@monorepo/access-server#build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**",
                "!**/*.tsbuildinfo",
                "!tests/**",
                "!delivery/**",
                "!README*"
            ],
            "outputs": []
        },
        "@monorepo/ty-demo#build": {
            "dependsOn": [
                "^build",
                "build:addon"
            ],
            "inputs": [
                "src/**/*.ts",
                "tsconfig.json",
                "package.json"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "build:addon": {
            "inputs": [
                "binding.gyp",
                "src/**/*.c",
                "src/**/*.cc",
                "src/**/*.cpp",
                "src/**/*.h",
                "src/**/*.hpp",
                "package.json"
            ],
            "env": [
                "TURBO_NATIVE_TOOLCHAIN",
                "CC",
                "CXX",
                "CFLAGS",
                "CXXFLAGS",
                "CPPFLAGS",
                "LDFLAGS",
                "AR",
                "PYTHON",
                "npm_config_python",
                "npm_config_arch",
                "npm_config_target",
                "npm_config_nodedir",
                "npm_config_disturl"
            ],
            "outputs": [
                "build/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true,
            "env": [
                "TURBO_ROOT_ENV",
                "NODE_ENV",
                "DATABASE_*",
                "TURSO_AUTH_TOKEN",
                "BETTER_AUTH_*",
                "ACCESS_*",
                "TY_DEMO_*",
                "DEMO_PORT",
                "NUXT_*",
                "NITRO_*",
                "PORT",
                "HOST"
            ]
        },
        "lint": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**"
            ],
            "outputs": []
        },
        "db:generate": {
            "inputs": [
                "prisma/schema.prisma",
                "prisma.config.ts",
                "package.json"
            ],
            "env": [
                "TURBO_ROOT_ENV",
                "DATABASE_URL",
                "NODE_ENV"
            ],
            "outputs": [
                "src/generated/**"
            ]
        },
        "db:push": {
            "cache": false,
            "env": [
                "DATABASE_URL"
            ]
        },
        "db:migrate": {
            "cache": false,
            "env": [
                "DATABASE_URL"
            ]
        },
        "db:deploy": {
            "cache": false,
            "env": [
                "DATABASE_URL"
            ]
        },
        "db:studio": {
            "cache": false,
            "persistent": true,
            "env": [
                "DATABASE_URL"
            ]
        },
        "@monorepo/access-web#build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**",
                "!**/*.tsbuildinfo",
                "!tests/**",
                "!delivery/**",
                "!README*"
            ],
            "env": [
                "TURBO_ROOT_ENV",
                "NODE_ENV",
                "DATABASE_*",
                "TURSO_AUTH_TOKEN",
                "BETTER_AUTH_*",
                "ACCESS_*",
                "TY_DEMO_*",
                "DEMO_PORT",
                "NUXT_*",
                "NITRO_*",
                "PORT",
                "HOST"
            ],
            "outputs": [
                ".output/**"
            ]
        },
        "@monorepo/ty-demo-app#build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!node_modules/**",
                "!dist/**",
                "!build/**",
                "!.nuxt/**",
                "!.output/**",
                "!.turbo/**",
                "!src/generated/**",
                "!**/*.tsbuildinfo",
                "!tests/**",
                "!delivery/**",
                "!README*"
            ],
            "env": [
                "TURBO_ROOT_ENV",
                "NODE_ENV",
                "DATABASE_*",
                "TURSO_AUTH_TOKEN",
                "BETTER_AUTH_*",
                "ACCESS_*",
                "TY_DEMO_*",
                "DEMO_PORT",
                "NUXT_*",
                "NITRO_*",
                "PORT",
                "HOST"
            ],
            "outputs": [
                ".output/**"
            ]
        }
    }
}
