{
    "name": "@monorepo/root",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.34.4",
    "scripts": {
        "verify": "tsx scripts/verify.ts",
        "build": "node scripts/run-turbo.mjs build",
        "lint": "node scripts/run-turbo.mjs lint",
        "dev": "node scripts/run-turbo.mjs dev",
        "clean": "pnpm -r run clean && rm -rf .turbo",
        "db:generate": "node scripts/run-turbo.mjs db:generate --filter=@monorepo/database",
        "db:push": "pnpm --filter @monorepo/database db:push",
        "db:studio": "pnpm --filter @monorepo/database db:studio",
        "build:plan": "node scripts/run-turbo.mjs build --dry=json"
    },
    "dependencies": {
        "turbo": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}