{
    "name": "@monorepo/database",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "db:push": "prisma db push --config prisma.config.ts",
        "db:generate": "prisma generate --config prisma.config.ts",
        "db:studio": "HOST=0.0.0.0 prisma studio --port 5555 --browser none --config prisma.config.ts",
        "build": "pnpm run db:generate && tsc -p tsconfig.json",
        "clean": "rm -rf dist .turbo node_modules/.cache *.tsbuildinfo"
    },
    "devDependencies": {
        "@monorepo/tooling": "workspace:*",
        "@types/node": "catalog:",
        "dotenv": "catalog:",
        "prisma": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@libsql/client": "catalog:",
        "@prisma/adapter-libsql": "catalog:",
        "@prisma/client": "catalog:"
    }
}