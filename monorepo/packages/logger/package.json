{
    "name": "@monorepo/logger",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./factory": {
            "types": "./dist/factory.d.ts",
            "import": "./dist/factory.js"
        },
        "./providers/*": {
            "types": "./dist/providers/*.d.ts",
            "import": "./dist/providers/*.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "pino": "catalog:",
        "pino-pretty": "catalog:"
    },
    "devDependencies": {
        "@monorepo/tooling": "workspace:*",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10.0.0"
    }
}