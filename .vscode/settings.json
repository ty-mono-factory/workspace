{
    "eslint.validate": [
        "typescript",
        "vue"
    ],
    "typescript.tsserver.path": "node_modules/typescript/lib",
    "search.exclude": {
        "**/.config": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.local": true,
        "**/.editorconfig": true,
        "**/pnpm-store": true,
        "**/ccache-storage": true,
        "**/corepack-cache": true,
        "**/node_modules": true,
        "**/output": true,
        "**/dist": true,
        "**/build": true,
        "**/.nuxt": true,
        "**/.bash_history": true,
        "**/.git-credentials": true,
        "**/pnpm-lock.yaml": true,
        "**/.gitconfig": true,
        "**/.gitignore": true,
        "**/.lesshst": true,
        "**/.viminfo": true,
        "**/*.db": true,
        "**/*.log": true,
        "**/*.md": true
    },
    // "files.exclude": {
    //   "**/.config": true,
    //   "**/.turbo": true,
    //   "**/.cache": true,
    //   "**/.local": true,
    //   "**/.editorconfig": true,
    //   "**/pnpm-store": true,
    //   "**/ccache-storage": true,
    //   "**/corepack-cache": true,
    //   "**/node_modules": true,
    //   "**/output": true,
    //   "**/dist": true,
    //   "**/build": true,
    //   "**/.nuxt": true,
    //   "**/.bash_history": true,
    //   "**/.git-credentials": true,
    //   "**/.gitconfig": true,
    //   "**/.lesshst": true,
    //   "**/.viminfo": true,
    //   "**/*.db": true,
    //   "**/*.log": true
    // },
    "files.watcherExclude": {
        "**/.config": true,
        "**/.turbo": true,
        "**/.cache": true,
        "**/.local": true,
        "**/.editorconfig": true,
        "**/pnpm-store": true,
        "**/ccache-storage": true,
        "**/corepack-cache": true,
        "**/node_modules": true,
        "**/output": true,
        "**/dist": true,
        "**/build": true,
        "**/.nuxt": true,
        "**/.bash_history": true,
        "**/.git-credentials": true,
        "**/.gitconfig": true,
        "**/.gitignore": true,
        "**/.lesshst": true,
        "**/.viminfo": true,
        "**/*.db": true,
        "**/*.log": true,
        "**/*.md": true
    },
    "[dockerfile]": {
        "editor.formatOnSave": false,
    },
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/projecs/ty_demo/node_modules/node-addon-api",
        "${workspaceFolder}/projecs/ty_demo/src",
        "/usr/include/node"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "[typescript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[vue]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "Vue.volar"
    }
}